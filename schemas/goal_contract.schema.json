{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalevo.dev/schemas/goal_contract.schema.json",
  "title": "Goal Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_contract_id",
    "world_id",
    "version",
    "parent_version",
    "status",
    "visibility",
    "effective_from",
    "effective_until",
    "clauses",
    "content_hash"
  ],
  "properties": {
    "goal_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "parent_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "effective",
        "superseded",
        "revoked"
      ]
    },
    "visibility": {
      "enum": [
        "system_visible",
        "researcher_only",
        "sealed"
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause_id",
          "clause_type",
          "description",
          "predicate",
          "scope",
          "priority",
          "source_ids",
          "authorization_requirement",
          "invalidation_policy"
        ],
        "properties": {
          "clause_id": {
            "type": "string",
            "minLength": 1
          },
          "clause_type": {
            "enum": [
              "hard_constraint",
              "soft_objective",
              "exception",
              "abstention",
              "authorization",
              "assurance"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "object"
          },
          "scope": {
            "type": "object"
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authorization_requirement": {
            "type": [
              "string",
              "null"
            ]
          },
          "invalidation_policy": {
            "enum": [
              "none",
              "prospective",
              "affected_history",
              "all_history"
            ]
          }
        }
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|draft-[a-z0-9-]+)$"
    }
  }
}
