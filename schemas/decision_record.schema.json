{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://goalevo.dev/schemas/decision_record.schema.json","title":"GoalEvo human decision record bundle","type":"object","additionalProperties":false,"required":["record_id","protocol_version","source","decisions","recorded_at","recorded_by"],"properties":{"record_id":{"type":"string","minLength":1},"protocol_version":{"type":"string","minLength":1},"source":{"type":"object","additionalProperties":false,"required":["repository","pull_request","comment_id","comment_url","author","created_at"],"properties":{"repository":{"type":"string","minLength":1},"pull_request":{"type":"integer","minimum":1},"comment_id":{"type":"integer","minimum":1},"comment_url":{"type":"string","format":"uri"},"author":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"}}},"decisions":{"type":"array","minItems":14,"maxItems":14,"items":{"type":"object","additionalProperties":false,"required":["id","decision","human_text","implementation_effect"],"properties":{"id":{"type":"string","pattern":"^D[0-9]{3}$"},"decision":{"enum":["approve","modify","reject","defer"]},"human_text":{"type":"string","minLength":1},"implementation_effect":{"type":"string","minLength":1}}}},"recorded_at":{"type":"string","format":"date-time"},"recorded_by":{"type":"string","minLength":1}}}