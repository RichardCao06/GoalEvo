{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalevo.dev/schemas/authority_graph.schema.json",
  "title": "Authority graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_graph_id",
    "world_id",
    "version",
    "effective_from",
    "roles",
    "permissions",
    "delegations",
    "content_hash"
  ],
  "properties": {
    "authority_graph_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "description"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "action",
          "target_artifact",
          "scope",
          "may_propose",
          "may_approve",
          "may_revoke"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "target_artifact": {
            "enum": [
              "task_result",
              "harness",
              "evaluator",
              "goal_contract",
              "autonomy_contract",
              "assurance_contract",
              "capability_envelope"
            ]
          },
          "scope": {
            "type": "object"
          },
          "may_propose": {
            "type": "boolean"
          },
          "may_approve": {
            "type": "boolean"
          },
          "may_revoke": {
            "type": "boolean"
          }
        }
      }
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|draft-[a-z0-9-]+)$"
    }
  }
}
