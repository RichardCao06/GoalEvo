{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalevo.dev/schemas/goal_truth_timeline.schema.json",
  "title": "Hidden goal truth timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timeline_id",
    "world_id",
    "visibility",
    "versions",
    "content_hash"
  ],
  "properties": {
    "timeline_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "enum": [
        "researcher_only",
        "sealed"
      ]
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "truth_version",
          "goal_contract_ref",
          "effective_from",
          "effective_until",
          "source_event_id",
          "authorized_by"
        ],
        "properties": {
          "truth_version": {
            "type": "string",
            "minLength": 1
          },
          "goal_contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorized_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|draft-[a-z0-9-]+)$"
    }
  }
}
