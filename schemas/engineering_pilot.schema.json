{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalevo.dev/schemas/engineering_pilot.schema.json",
  "title": "GoalEvo Phase 2 engineering pilot",
  "type": "object",
  "additionalProperties": false,
  "required": ["pilot_id", "version", "status", "protocol_ref", "protocol_version", "authorized_scope", "confirmatory_use", "worlds", "methods", "reference_runner", "live_pilot", "mutation_surface", "human_decision_file", "sealed_test_status"],
  "properties": {
    "pilot_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["scaffold_ready", "live_ready", "running", "pilot_complete"]},
    "protocol_ref": {"type": "string", "minLength": 1},
    "protocol_version": {"const": "0.1.0"},
    "authorized_scope": {"enum": ["deterministic_reference_only", "live_engineering_pilot"]},
    "confirmatory_use": {"const": "prohibited"},
    "worlds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "methods": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["M0", "M1", "M2", "M3"]}},
    "reference_runner": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "model_id", "scenario_file", "checked_result_file", "live_model_calls", "seeds", "generations"],
      "properties": {
        "enabled": {"const": true},
        "model_id": {"const": "deterministic-reference-policy-v0"},
        "scenario_file": {"type": "string", "minLength": 1},
        "checked_result_file": {"type": "string", "minLength": 1},
        "live_model_calls": {"const": false},
        "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "generations": {"type": "integer", "minimum": 1}
      }
    },
    "live_pilot": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized", "provider", "model_id", "model_version", "budget", "scale", "blinding"],
      "properties": {
        "authorized": {"type": "boolean"},
        "provider": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "budget": {"type": ["object", "null"]},
        "scale": {"type": ["object", "null"]},
        "blinding": {"type": ["object", "null"]}
      }
    },
    "mutation_surface": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_mutation", "oracle_mutation", "metric_mutation", "split_mutation", "max_atomic_patches_per_generation"],
      "properties": {
        "runner_mutation": {"const": "prohibited"},
        "oracle_mutation": {"const": "prohibited"},
        "metric_mutation": {"const": "prohibited"},
        "split_mutation": {"const": "prohibited"},
        "max_atomic_patches_per_generation": {"type": "integer", "minimum": 1}
      }
    },
    "human_decision_file": {"type": "string", "minLength": 1},
    "sealed_test_status": {"const": "not_created"}
  }
}
