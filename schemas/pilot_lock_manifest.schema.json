{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://goalevo.dev/schemas/pilot_lock_manifest.schema.json","title":"GoalEvo Protocol v0.1 pilot lock manifest","type":"object","additionalProperties":false,"required":["manifest_id","protocol_id","protocol_version","status","authorized_scope","human_decision_source","semantic_baseline_commit","attestation_method","artifact_groups","validation_commands","confirmatory_blockers","created_at"],"properties":{"manifest_id":{"type":"string","minLength":1},"protocol_id":{"type":"string","minLength":1},"protocol_version":{"const":"0.1.0"},"status":{"enum":["candidate","pilot_locked"]},"authorized_scope":{"const":"engineering_pilot"},"human_decision_source":{"type":"string","minLength":1},"semantic_baseline_commit":{"type":"string","pattern":"^(pending|[0-9a-f]{40})$"},"attestation_method":{"type":"string","minLength":1},"artifact_groups":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"validation_commands":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"confirmatory_blockers":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"created_at":{"type":"string","format":"date-time"}}}